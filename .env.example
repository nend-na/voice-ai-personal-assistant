# ---- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI model ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxx
CONVERSATION_MODEL=claude-sonnet-4-6

# ---- Google Calendar OAuth ---------------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# 32-byte key, base64-encoded, used to encrypt stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---- Voice (see README "Voice architecture" for current status) ------------
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
